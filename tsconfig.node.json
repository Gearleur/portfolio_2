{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts", "eslint.config.js", "build/**/*.ts", "src/agent/**/*.ts", "src/agent/**/*.tsx",
    "src/data/profile.ts", "src/data/professionalExperience.ts", "src/types/window.ts",
    "src/components/machine/machineResumeData.ts", "src/components/machine/machineResumeMarkdown.ts",
    "src/components/machine/MachineResumeDocument.tsx"
  ],
  "exclude": ["**/*.test.ts"]
}
